{
  "name": "talde-hemendik-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "pretest": "npm run migrate",
    "test": "npm run test:vs01 && npm run test:vs02",
    "test:vs01": "npm run seed && vitest run test/integration/invitation.test.ts test/integration/vertical-slice.test.ts --no-file-parallelism",
    "test:vs02": "npm run seed && vitest run test/integration/events-vs02.test.ts test/integration/operations-vs02.test.ts test/integration/dev-reset-cors.test.ts --no-file-parallelism",
    "test:integration": "npm test",
    "demo": "tsx scripts/demo-vs01.ts",
    "demo:vs02": "npm run seed && tsx scripts/demo-vs02.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
